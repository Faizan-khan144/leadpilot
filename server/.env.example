# Server
NODE_ENV=development
PORT=5200
CLIENT_URL=http://localhost:5201
MONGODB_URI=mongodb://127.0.0.1:27017/leadpilot
USE_MEMORY_DB=false
SEED_DEMO=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=leadpilot_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300

# Optional SMTP email delivery for password resets and invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LeadPilot <no-reply@example.com>

# Demo seed
SEED_OWNER_EMAIL=owner@demo.leadpilot.test
SEED_OWNER_PASSWORD=LeadPilot123!
